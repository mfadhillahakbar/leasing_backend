{
  "name": "leasing_backend",
  "description": "",
  "version": "0.0.0",
  "homepage": "",
  "private": true,
  "keywords": [
    "feathers"
  ],
  "author": {},
  "contributors": [],
  "bugs": {},
  "engines": {
    "node": ">= 22.3.0"
  },
  "feathers": {
    "language": "js",
    "packager": "yarn",
    "database": "mssql",
    "framework": "express",
    "transports": [
      "rest",
      "websockets"
    ],
    "schema": "typebox"
  },
  "directories": {
    "lib": "src",
    "test": "test"
  },
  "files": [
    "lib/client.js",
    "lib/**/*.d.ts",
    "lib/**/*.shared.js"
  ],
  "main": "src/client",
  "type": "module",
  "scripts": {
    "start": "node src",
    "dev": "nodemon src/",
    "prettier": "npx prettier \"**/*.js\" --write",
    "mocha": "cross-env NODE_ENV=test mocha test/ --recursive --exit",
    "test": "cross-env NODE_ENV=test npm run migrate && npm run mocha",
    "bundle:client": "npm pack --pack-destination ./public",
    "migrate": "knex migrate:latest",
    "migrate:make": "knex migrate:make -x mjs"
  },
  "dependencies": {
    "@feathersjs/adapter-commons": "^5.0.34",
    "@feathersjs/authentication": "^5.0.34",
    "@feathersjs/authentication-client": "^5.0.34",
    "@feathersjs/authentication-local": "^5.0.34",
    "@feathersjs/authentication-oauth": "^5.0.34",
    "@feathersjs/configuration": "^5.0.34",
    "@feathersjs/errors": "^5.0.34",
    "@feathersjs/express": "^5.0.34",
    "@feathersjs/feathers": "^5.0.34",
    "@feathersjs/knex": "^5.0.34",
    "@feathersjs/schema": "^5.0.34",
    "@feathersjs/socketio": "^5.0.34",
    "@feathersjs/transport-commons": "^5.0.34",
    "@feathersjs/typebox": "^5.0.34",
    "compression": "^1.8.0",
    "dayjs": "^1.11.13",
    "dotenv": "^17.0.1",
    "feathers-hooks-common": "^8.2.1",
    "file-type": "^21.0.0",
    "knex": "^3.1.0",
    "mssql": "^11.0.1",
    "multer": "^2.0.1",
    "winston": "^3.17.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@feathersjs/cli": "5.0.34",
    "@feathersjs/rest-client": "^5.0.34",
    "axios": "^1.9.0",
    "cross-env": "^7.0.3",
    "mocha": "^11.2.2",
    "nodemon": "^3.1.10",
    "prettier": "^3.6.2"
  }
}
